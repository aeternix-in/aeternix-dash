# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Random string used to salt UHID hashes. Server-only: do NOT add a NEXT_PUBLIC_ prefix.
# Pick once, keep it safe, and never change it (changing it breaks matching of old hashes).
UHID_SALT=change-me-to-a-long-random-string

# Only for `npm run seed` (local, never commit). A study-team login you created in Supabase Auth.
SEED_EMAIL=you@example.com
SEED_PASSWORD=your-password
